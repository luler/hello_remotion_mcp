# ==============================================================================
# Remotion Studio MCP 环境配置文件模板
# 使用方法：复制本文件为 .env 并按需修改对应值
# ==============================================================================

# ----------------- 1. 网络与基础配置 -----------------
# 宿主机映射的服务端口（默认 48001）
PORT=48001

# 外部公开访问 Base URL
# 留空：自动根据客户端每次发起的 HTTP 请求头（Host / X-Forwarded-Host）动态识别拼接
# 填写示例：https://video.yourcompany.com 或 http://192.168.1.100:48001
BASE_URL=

# 访问鉴权安全密钥 (Token)
# 留空：免密访问（推荐局域网或内网开发使用）
# 填写：若配置（如 sk_remotion_8888），则客户端访问 /mcp 端点需携带 Bearer 凭证，访问 /admin 后台会弹出密码锁屏验证
AUTH_KEY=

# ----------------- 2. 渲染性能与超时控制 -----------------
# 单个视频渲染最大超时秒数（默认 600 秒 / 10 分钟）
# 超过该时间自动强制杀死底层运行的 Chromium 渲染进程以释放服务器资源。
RENDER_TIMEOUT=600

# Remotion 内部并发启动的浏览器渲染标签页数（默认 85%）
# 充分榨取服务器多核 CPU 算力（如 8 核机器使用 7 个标签页并行），提速显著
REMOTION_CONCURRENCY=85%


# x264 视频压缩算法预设档位（默认 superfast）
# 相比 veryfast 编码耗时减少 30%~40%，兼具优异画质
X264_PRESET=superfast

# 异步并发限流信号量（默认允许同时渲染 2 个任务）
# 防止多客户端同时大批量提交视频生成任务而挤死 CPU 与内存，超出部分将排队平滑处理
MAX_CONCURRENT_RENDERS=2

